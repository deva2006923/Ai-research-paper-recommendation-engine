# Server configuration
PORT=8000
HOST=0.0.0.0

# Database
# For SQLite, use sqlite:///./app.db. For PostgreSQL, use postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./app.db

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# API Keys
# Optional but recommended to avoid GitHub Search API rate limit (5 requests/min unauthenticated)
GITHUB_TOKEN=your_github_token_here

# Required for AI recommendations, differentiation, code generation, and chat assistant
# Get your free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use (see https://console.groq.com/docs/models for options)
GROQ_MODEL=llama-3.3-70b-versatile

# Admin Configuration
ADMIN_PASSWORD=deva@2006
